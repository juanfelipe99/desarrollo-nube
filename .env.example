# --- Aplicación ---------------------------------------------------------------
# Entorno de ejecución. Opcional: desarrollo | produccion
APP_ENTORNO=desarrollo
# Puerto de la API. Opcional, por defecto 8080
APP_PUERTO=8080
# Zona horaria de las fechas. Opcional, por defecto America/Bogota
APP_ZONA_HORARIA=America/Bogota

# --- PostgreSQL -----------------------------------------------------------------
# Conexión completa. Opcional, reemplaza a las demás
# DATABASE_URL=postgres://usuario:clave@host:5432/bd?sslmode=require
# Usuario de la base. Obligatoria
POSTGRES_USER=seguimiento
# Clave del usuario. Obligatoria
POSTGRES_PASSWORD=cambie-esta-clave
# Servidor. Obligatoria, localhost en tu equipo o postgres en Docker Compose
POSTGRES_HOST=localhost
# Puerto del servidor. Opcional, por defecto 5432
POSTGRES_PUERTO=5432
# Nombre de la base. Obligatoria
POSTGRES_DB=seguimiento
# Cifrado de la conexión. Opcional: disable (local) | require (nube)
POSTGRES_SSLMODE=disable
